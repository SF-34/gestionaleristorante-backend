# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development

# SQL Server
CONNECTIONSTRINGS__DEFAULT=Server=(localdb)\\mssqllocaldb;Database=GestionaleRistoranteDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT
JWT__ISSUER=GestionaleRistorante
JWT__AUDIENCE=GestionaleRistorante.Client
JWT__ACCESSTOKENSECRET=CHANGE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_33_BYTES
JWT__ACCESSTOKENMINUTES=30
JWT__REFRESHTOKENDAYS=7

# Seed admin credentials (required)
SEED_ADMIN_EMAIL=admin@ristorante.local
SEED_ADMIN_PASSWORD=ChangeThisPassword!123
# Optional: if true, update existing admin with seed password at startup (useful in local dev)
SEED_ADMIN_UPDATE_EXISTING=false

# Azure Blob Storage
AZUREBLOB__CONNECTIONSTRING=
AZUREBLOB__CONTAINERNAME=dish-images

# CORS
CORS__ALLOWEDORIGINS__0=http://localhost:4200
